# Copy to .env and fill in. Never commit .env.
# Only the providers used by the model tiers below need a key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=            # needed when a tier uses a gemini: model
OPENAI_API_KEY=            # not used: there is no OpenAI adapter yet

# Langfuse. The cloud free tier is the default: create a project at
# https://cloud.langfuse.com and paste its keys below. Tracing is on when both keys are set;
# leave either empty to run without it.
# The optional self-hosted stack (docs/langfuse.md) listens on http://localhost:3000.
# Point LANGFUSE_HOST there only after you have started it. Nothing starts it for you.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Master switch: set to false to turn tracing off even when the keys are set
BRANDFORGE_TRACING_ENABLED=true

# Logs go to stderr, one JSON object per line, and carry the run id for the length of a run.
# BRANDFORGE_LOG_FORMAT=console renders the same fields for a person. Level is case-insensitive.
BRANDFORGE_LOG_LEVEL=INFO
BRANDFORGE_LOG_FORMAT=json

# Model tiers, as provider:model (nested: BRANDFORGE_MODELS__<TIER>)
# The provider prefix selects the adapter. Available: anthropic, gemini.
# Example of a Gemini tier (use a real model ID, and set that tier's prices below):
#   BRANDFORGE_MODELS__JUDGE=gemini:<model-id>
BRANDFORGE_MODELS__STRONG=anthropic:claude-sonnet-5-5
BRANDFORGE_MODELS__FAST=anthropic:claude-haiku-4-5-20251001
BRANDFORGE_MODELS__JUDGE=anthropic:claude-opus-5-5

# Price per million tokens, per tier. Change these whenever a tier's model or provider changes.
BRANDFORGE_PRICING__STRONG__INPUT_PER_MTOK=2.0
BRANDFORGE_PRICING__STRONG__OUTPUT_PER_MTOK=10.0
BRANDFORGE_PRICING__FAST__INPUT_PER_MTOK=1.0
BRANDFORGE_PRICING__FAST__OUTPUT_PER_MTOK=5.0
BRANDFORGE_PRICING__JUDGE__INPUT_PER_MTOK=4.0
BRANDFORGE_PRICING__JUDGE__OUTPUT_PER_MTOK=20.0

# Prompt-cache multipliers on the tier's input price (BF-27). One pair per provider.
# Anthropic's 5-minute cache: writes 1.25x, reads 0.1x. Gemini implicit cache: reads 0.1x
# (90% off) and no write premium, because a miss is billed as ordinary input.
# A tier may override one side. Sonnet 5.5 and Opus 5.5 publish a 0.05x read, so the strong
# and judge tiers do. Clear the override when you point that tier at a model that uses the
# provider default (Haiku 4.5 is 0.1x, and so is Gemini).
BRANDFORGE_PRICING__ANTHROPIC_CACHE__WRITE_MULTIPLIER=1.25
BRANDFORGE_PRICING__ANTHROPIC_CACHE__READ_MULTIPLIER=0.1
BRANDFORGE_PRICING__GEMINI_CACHE__WRITE_MULTIPLIER=1.0
BRANDFORGE_PRICING__GEMINI_CACHE__READ_MULTIPLIER=0.1
BRANDFORGE_PRICING__STRONG__CACHE_READ_MULTIPLIER=0.05
BRANDFORGE_PRICING__JUDGE__CACHE_READ_MULTIPLIER=0.05

# Budgets
# Per-run limits. When either is reached the router starts no more revisions, and the gateway
# makes no more model calls in the node that is running. The run ends with what it has.
BRANDFORGE_BUDGETS__MAX_TOKENS_PER_RUN=60000
BRANDFORGE_BUDGETS__MAX_WALL_CLOCK_SECONDS=90
BRANDFORGE_BUDGETS__MAX_REVISIONS=2
# Total attempts per model call on timeouts, rate limits and 5xx (first try included)
BRANDFORGE_BUDGETS__MAX_LLM_RETRIES=3
BRANDFORGE_BUDGETS__RETRY_INITIAL_WAIT_SECONDS=1
BRANDFORGE_BUDGETS__RETRY_MAX_WAIT_SECONDS=20
# Extra calls per model call when the reply fails schema validation (0 = no repair)
BRANDFORGE_BUDGETS__MAX_SCHEMA_REPAIRS=1
BRANDFORGE_BUDGETS__MAX_OUTPUT_TOKENS_PER_CALL=2048
BRANDFORGE_BUDGETS__REQUEST_TIMEOUT_SECONDS=60

# Pass thresholds
BRANDFORGE_THRESHOLDS__MIN_OVERALL=4.0
BRANDFORGE_THRESHOLDS__MIN_PER_CRITERION=3

# Checkpoints: the run state is saved here after every node (read it with `brandforge inspect`)
BRANDFORGE_CHECKPOINT_DB=.brandforge/checkpoints.sqlite

# Example index: `brandforge index` writes one Chroma collection per brand here.
# The directory is git-ignored. Embeddings are local and need no API key (ADR 0023).
BRANDFORGE_CHROMA_DIR=.brandforge/chroma

# Feature flags
BRANDFORGE_RETRIEVAL_ENABLED=true
# v2 marks the static prefix (instructions and brand profile) for prompt caching. v1 is the
# same words as a single message, with no cache break.
BRANDFORGE_BASELINE_PROMPT_VERSION=v2
BRANDFORGE_BASELINE_VARIANTS_PER_CHANNEL=3
BRANDFORGE_PLANNER_PROMPT_VERSION=v2
BRANDFORGE_PLANNER_MAX_VARIANTS_PER_CHANNEL=5
BRANDFORGE_WRITER_PROMPT_VERSION=v2
BRANDFORGE_CRITIC_PROMPT_VERSION=v2
BRANDFORGE_REVISER_PROMPT_VERSION=v2
BRANDFORGE_REPAIR_PROMPT_VERSION=v1
